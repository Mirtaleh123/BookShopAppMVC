@{
    ViewData["Title"] = "Admin Panel";
}

<div style="display:flex; min-height:calc(100vh - 60px);">

    <!-- Sidebar -->
    <div style="width:200px; background:#fff; border-right:1px solid #eee; padding:16px 0; flex-shrink:0;">
        <div style="padding:0 16px 16px; border-bottom:1px solid #eee; margin-bottom:8px;">
            <div style="font-size:14px; font-weight:500; color:#1a1a1a;">Admin Panel</div>
            <div style="font-size:11px; color:#999;">Ali & Nino</div>
        </div>
        <a href="#sifarisler" style="display:flex;align-items:center;gap:8px;padding:10px 16px;color:#555;text-decoration:none;font-size:13px;">
            <i class="bi bi-bag"></i> Sifarişlər
        </a>
        <a href="#kitablar" style="display:flex;align-items:center;gap:8px;padding:10px 16px;color:#555;text-decoration:none;font-size:13px;">
            <i class="bi bi-book"></i> Kitablar
        </a>
        <a asp-controller="Book" asp-action="Index" style="display:flex;align-items:center;gap:8px;padding:10px 16px;color:#555;text-decoration:none;font-size:13px;">
            <i class="bi bi-arrow-left"></i> Mağazaya qayıt
        </a>
    </div>

    <!-- Main -->
    <div style="flex:1; padding:24px; background:#f9f9f9;">

        <!-- Statistika -->
        <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-bottom:24px;">
            <div style="background:#fff; border:1px solid #eee; border-radius:10px; padding:16px;">
                <div style="font-size:11px; color:#999; margin-bottom:4px;">Ümumi sifariş</div>
                <div style="font-size:24px; font-weight:500;">@ViewBag.TotalOrders</div>
            </div>
            <div style="background:#fff; border:1px solid #eee; border-radius:10px; padding:16px;">
                <div style="font-size:11px; color:#999; margin-bottom:4px;">Gözləyən</div>
                <div style="font-size:24px; font-weight:500; color:#d1332f;">@ViewBag.PendingOrders</div>
            </div>
            <div style="background:#fff; border:1px solid #eee; border-radius:10px; padding:16px;">
                <div style="font-size:11px; color:#999; margin-bottom:4px;">Kitab sayı</div>
                <div style="font-size:24px; font-weight:500;">@ViewBag.TotalBooks</div>
            </div>
            <div style="background:#fff; border:1px solid #eee; border-radius:10px; padding:16px;">
                <div style="font-size:11px; color:#999; margin-bottom:4px;">Ümumi gəlir</div>
                <div style="font-size:24px; font-weight:500; color:#2a7a2a;">@ViewBag.TotalRevenue.ToString("0.00") AZN</div>
            </div>
        </div>

        <!-- Sifarişlər -->
        <div id="sifarisler" style="background:#fff; border:1px solid #eee; border-radius:10px; padding:16px; margin-bottom:20px;">
            <h5 style="font-size:15px; font-weight:500; margin-bottom:16px;">
                <i class="bi bi-bag me-2"></i>Sifarişlər
            </h5>
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Kitablar</th>
                        <th>Məbləğ</th>
                        <th>Tarix</th>
                        <th>Status</th>
                        <th>Əməliyyat</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in ViewBag.Orders)
                    {
                        <tr>
                            <td>#@order.Id</td>
                            <td>
                                @foreach (var item in order.OrderItems)
                                {
                                    <div style="font-size:12px;">@item.Book.Title (@item.Quantity ədəd)</div>
                                }
                            </td>
                            <td>@order.TotalPrice.ToString("0.00") AZN</td>
                            <td style="font-size:12px;">@order.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                @if (order.Status == "Gözləyir")
                                {
                                    <span class="badge" style="background:#faeeda;color:#633806;">Gözləyir</span>
                                }
                                else if (order.Status == "Təsdiqləndi")
                                {
                                    <span class="badge" style="background:#eaf3de;color:#27500a;">Təsdiqləndi</span>
                                }
                                else
                                {
                                    <span class="badge" style="background:#fcebeb;color:#791f1f;">@order.Status</span>
                                }
                            </td>
                            <td>
                                @if (order.Status == "Gözləyir")
                                {
                                    <form asp-action="UpdateStatus" method="post" style="display:inline;">
                                        <input type="hidden" name="id" value="@order.Id" />
                                        <input type="hidden" name="status" value="Təsdiqləndi" />
                                        <button type="submit" class="btn btn-sm"
                                                style="font-size:11px;background:#eaf3de;color:#27500a;border:1px solid #c3e6a0;">
                                            Təsdiqlə
                                        </button>
                                    </form>
                                    <form asp-action="UpdateStatus" method="post" style="display:inline;">
                                        <input type="hidden" name="id" value="@order.Id" />
                                        <input type="hidden" name="status" value="Ləğv edildi" />
                                        <button type="submit" class="btn btn-sm"
                                                style="font-size:11px;background:#fcebeb;color:#791f1f;border:1px solid #f4c9c8;">
                                            Ləğv et
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Kitablar -->
        <div id="kitablar" style="background:#fff; border:1px solid #eee; border-radius:10px; padding:16px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                <h5 style="font-size:15px; font-weight:500; margin:0;">
                    <i class="bi bi-book me-2"></i>Kitablar
                </h5>
                <a asp-controller="Book" asp-action="Create" class="btn btn-sm btn-brand">
                    <i class="bi bi-plus"></i> Yeni kitab
                </a>
            </div>
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Ad</th>
                        <th>Müəllif</th>
                        <th>Qiymət</th>
                        <th>Stok</th>
                        <th>Əməliyyat</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var book in ViewBag.Books)
                    {
                        <tr>
                            <td style="font-size:13px;">@book.Title</td>
                            <td style="font-size:13px;">@book.Author</td>
                            <td style="font-size:13px;">@book.Price.ToString("0.00") AZN</td>
                            <td>
                                @if (book.Stock == 0)
                                {
                                    <span class="badge" style="background:#fcebeb;color:#791f1f;">Tükənib</span>
                                }
                                else if (book.Stock <= 5)
                                {
                                    <span class="badge" style="background:#faeeda;color:#633806;">@book.Stock ədəd</span>
                                }
                                else
                                {
                                    <span class="badge" style="background:#eaf3de;color:#27500a;">@book.Stock ədəd</span>
                                }
                            </td>
                            <td>
                                <a asp-controller="Book" asp-action="Edit" asp-route-id="@book.Id"
                                   class="btn btn-sm" style="font-size:11px;border:1px solid #ddd;">
                                    Redaktə
                                </a>
                                <a asp-controller="Book" asp-action="Delete" asp-route-id="@book.Id"
                                   class="btn btn-sm" style="font-size:11px;background:#fcebeb;color:#791f1f;border:1px solid #f4c9c8;">
                                    Sil
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>
