<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ali_və_Nino_Kitab_Mağazası</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/E_Kitabxana.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm bg-white shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Book" asp-action="Index">
                    <img src="https://static.insales-cdn.com/r/XA2GG-fJxr0/rs:fill-down:100:100:1/q:100/plain/files/1/2841/119417625/original/Logo_3__1_.png@png" alt="Logo" class="brand-logo">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 align-items-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Book" asp-action="Index">Kitablar</a>
                        </li>
                        <form method="get" asp-controller="Book" asp-action="Index" class="d-flex flex-grow-1 ms-3">
                            <input class="form-control search-input me-2" type="search" name="search" placeholder="Kitab axtar..." />
                            <button class="btn btn-brand">Axtar</button>
                        </form>
                    </ul>
                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item d-flex align-items-center user-badge me-3">
                                <i class="bi bi-person"></i>&nbsp;Salam, <strong>@User.Identity.Name</strong>
                            </li>
                            <li class="nav-item">
                                <form asp-action="Logout" asp-controller="Account" method="post">
                                    <button type="submit" class="btn btn-outline-brand btn-sm">Çıxış</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-brand btn-sm" asp-controller="Account" asp-action="Login">Giriş</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>