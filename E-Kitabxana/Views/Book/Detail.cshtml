@model E_Kitabxana.Models.Book
@{
    ViewData["Title"] = Model.Title;
}

<div class="detail-layout">
    <div class="detail-img-col">
        <img src="@Model.ImageUrl" alt="@Model.Title" class="detail-img" />
    </div>

    <div class="detail-info-col">
        <h1 class="detail-title">@Model.Title</h1>
        <p class="detail-author">Müəllif: <span>@Model.Author</span></p>

        <div class="detail-price-box">
            <span class="detail-price">@Model.Price.ToString("0.00") AZN</span>
        </div>

        <div class="detail-actions">
            <a asp-controller="Book" asp-action="Read" asp-route-id="@Model.Id" class="btn-read">
                <i class="bi bi-book"></i> Oxumağa başla
            </a>
            <a asp-action="Index" class="btn-outline-secondary">Geri qayıt</a>
        </div>
    </div>
</div>

<div class="detail-about">
    <h2>Haqqında</h2>
    <p>@Model.About</p>
</div>
