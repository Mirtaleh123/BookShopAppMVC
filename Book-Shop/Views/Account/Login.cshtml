@model Book_Shop.ViewModels.LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Login</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
            body {
                background: #f7f7f7;
                height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
            }

            .login-card {
                width: 380px;
                background: #ffffff;
                padding: 40px 30px 28px;
                border-radius: 12px;
                border: 1px solid #eee;
                box-shadow: 0 4px 16px rgba(0,0,0,0.08);
                position: relative;
            }

            .logo {
                width: 64px;
                height: 64px;
                border-radius: 50%;
                border: 2px solid #d1332f;
                position: absolute;
                top: -32px;
                left: 50%;
                transform: translateX(-50%);
                background: white;
                padding: 6px;
            }

            .login-title {
                margin-top: 24px;
                margin-bottom: 20px;
                text-align: center;
                font-size: 22px;
                font-weight: 600;
                color: #1a1a1a;
            }

            .login-card label {
                color: #555;
                font-size: 12px;
                margin-bottom: 6px;
                display: block;
            }

            .form-control {
                border-radius: 6px;
                border: 1px solid #ddd;
                height: 38px;
            }

                .form-control:focus {
                    border-color: #d1332f;
                    box-shadow: 0 0 0 2px rgba(209, 51, 47, 0.15);
                }

            .btn-login {
                width: 100%;
                height: 40px;
                font-size: 14px;
                font-weight: 500;
                border: none;
                border-radius: 6px;
                background: #d1332f;
                color: white;
                margin-top: 6px;
            }

                .btn-login:hover {
                    background: #b32925;
                }

    </style>
</head>
<body>

    <div class="login-card">

        <img src="data:image/jpeg;base64," class="logo" />

        <h1 class="login-title">Giriş</h1>

        <form asp-action="Login" method="post">

            <div class="mb-3">
                <label asp-for="Username"></label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-login">
                Login
            </button>

        </form>

    </div>

</body>
</html>
